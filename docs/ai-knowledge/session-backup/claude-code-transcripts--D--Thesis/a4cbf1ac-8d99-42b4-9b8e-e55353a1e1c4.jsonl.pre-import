{"parentUuid":"7a65df74-f287-4cbc-b21f-d10a05eca8d4","isSidechain":false,"message":{"content":[{"id":"toolu_bdrk_01SQgppEgfZUVmVKF8CXfguK","input":{"command":"pdftotext -f 7 -l 12 -enc UTF-8 proposal/proposal.pdf - 2>/dev/null","description":"Extract proposal pages 7-12"},"name":"Bash","type":"tool_use"}],"id":"msg_bdrk_xeelvoauim5h6xql2ijmoysnliqrp7jhis4hcsqo3sux3iaxi3ba","model":"claude-opus-5","role":"assistant","stop_details":null,"stop_reason":"tool_use","stop_sequence":null,"type":"message","usage":{"input_tokens":2,"cache_creation_input_tokens":8401,"cache_read_input_tokens":97030,"output_tokens":801,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":8401},"inference_geo":"","iterations":[],"speed":"standard"}},"requestId":"2026082505584736156407569d7bAYxUxMNX","attributionSkill":"research-review","type":"assistant","uuid":"dc26f7ca-b281-46dd-9f22-7916f302b752","timestamp":"2026-08-24T21:59:02.162Z","effort":"high","session_id":"a4cbf1ac-8d99-42b4-9b8e-e55353a1e1c4","userType":"external","entrypoint":"cli","cwd":"D:\\Thesis","sessionId":"a4cbf1ac-8d99-42b4-9b8e-e55353a1e1c4","version":"2.1.240","gitBranch":"main"}
{"parentUuid":"7a65df74-f287-4cbc-b21f-d10a05eca8d4","isSidechain":false,"promptId":"8a148a04-113d-49e3-97e3-5b75a3bfc9aa","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_bdrk_01CNdqYbMG9X47fNhPHZDDdt","type":"tool_result","content":"‫‪ -1‬تعریف مسأله و بيان موضوع اصلی تحقيق‬\r\n‫شبکههای توزیع آب ‪ (WDNs)‬بنیادیترین زیرساخت برای پایداری تمدنها محسوب میشوند و بهعنوان دانشکسدهیمهندسسیتصنایعم‬ ‫گردش حیاتی محیطهای شهری عمل میکنند. با افزایش همزمان تقاضای صنعتی و رشد نمایی جمعیت، مدیریت‬ ‫راهبردی منابع آب دیگر صرفاً یک فعالیت عملیاتی روزمره نیست، بلکه به مسئلهای مرتبط با امنیت ملی و جهانی‬ ‫تبدیل شده است. در این چارچوب، بحران جهانی کمبود آب بهدلیل ناکارآمدیهای ساختاری تشدید میشود؛‬ ‫برآوردها نشان میدهد سالانه حدود ‪ ۳۲‬میلیارد مترمکعب آب تصفیهشده در سامانههای توزیع جهانی هدر میرود‬\r\n‫.‪(Guo et al., 2013)‬کاهش این تلفات برای تضمین پایداری و تابآوری شهری ضروری است.‬\r\n\r\n‫در ادبیات مهندسی هیدرولیک، تمایز میان «تلفات واقعی» یعنی خروج فیزیکی آب از سیستم از طریق ترکیدگی‬ ‫لولهها، نشتی اتصالات و سرریز مخازن و مفهوم گستردهتر «آب بدون درآمد» ضروری است.‬\r\n\r\n‫علاوه بر تلفات واقعی، شامل مصرف مجاز بدون صورتحساب و تلفات تجاری نیز میشود. کاهش آب بدون درآمد‬ ‫صرفاً یک هدف مالی نیست، بلکه ضرورتی برای حفظ منابع آب بهشمار میرود. آمار مربوط به آب بدون درآمد‬\r\n‫نشاندهنده تفاوت شدید در بهرهوری زیرساختها میان کشورهای مختلف است:‬\r\n\r\n‫نرخ تقریبی آب بدون درآمد / نشتی‬\r\n\r\n‫منطقه / شرایط‬\r\n\r\n‫استاندارد کشورهای توسعهیافته حدود ‪1۵٪‬‬\r\n\r\n‫‪ 1۵٪‬تا ‪( ۳0٪‬طبش و واسطی، ‪)1۳8۵‬‬\r\n\r\n‫ایران )میانگین ملی(‬\r\n\r\n‫حدود ‪( ۳۲٪‬مرکز پژوهشهای مجلس، ‪)1۳۹۷‬‬\r\n\r\n‫ایران )بخش روستایی(‬\r\n\r\n‫میانگین کشورهای درحالتوسعه ‪ ۲0٪‬تا ‪۷0٪‬‬\r\n\r\n‫موارد بحرانی جهانی )مانند کامرون( ‪(Lemberger & Wyatt, 2018)۵0٫8٪‬‬\r\n\r\n‫از دیدگاه مهندسی سیستمها، فشار هیدرولیکی مهمترین عامل تخریب زیرساخت است. پژوهشهای دقیق سلطانی‬ ‫و مغربی )‪ )1۳88‬تأیید میکند که فشار بیشازحد مستقیماً با خستگی سریعتر لولهها، افزایش دفعات شکست و‬ ‫تشدید نرخ نشتی ارتباط دارد. اگرچه فشار بالا برای حفظ کیفیت خدمترسانی در ساعات اوج مصرف ضروری‬ ‫است، اما در ساعات کممصرف شبانه به یک تهدید ساختاری تبدیل میشود. راهبردهای فعلی مدیریت فشار بهدلیل‬\r\n‫ناتوانی تجهیزات کنترلی سنتی در تطبیق با این نوسانات، موجب فرسودگی زودهنگام زیرساخت میشوند.‬\r\n\r\n\f‫در تحقیقات هیدرولیک مدرن فاصله عمیقی میان مدیریت ایستا و ماهیت پویا و تصادفی مصرف آب شهری است.‬ ‫شبکههای مدرن توزیع آب دارای ابعاد بالا و تعاملات غیرخطی میان پمپها، مخازن و لولههایی با سنهای دانمشکدهمخهندتسلیصنایعف‬ ‫هستند که همگی تحت قوانین بقای جرم و انرژی )معادلات افت هد( عمل میکنند. مدلسازی ریاضی سنتی‬ ‫تلاش کرده این سامانهها را تحلیل کند، اما پیچیدگی محاسباتی حاصل، مانع بهینهسازی بلادرنگ میشود.‬ ‫اپراتورهای انسانی توانایی پردازش همزمان دادههای چندمتغیره — مانند نوسانات شبانهروزی دبی و شرایط خاک‬\r\n‫— را با سرعت لازم برای تنظیمات پیشگیرانه ندارند.‬\r\n‫مدیریت سنتی شیرهای فشارشکن‪ ، (PRVs)‬همانطور که توسط ‪ Vicente et al. (2016)‬بررسی شده، عمدتاً‬ ‫مبتنی بر «فشار خروجی ثابت» است. این روش عملاً منسوخ شده است؛ زیرا برای تضمین حداقل فشار خدماتی‬ ‫در گرههای بحرانی طی ساعات اوج مصرف، ‪PRV‬ها روی مقادیر بالای ثابت تنظیم میشوند. در نتیجه، در ساعات‬ ‫کممصرف شبانه، شبکه در معرض «موج» تنش هیدرولیکی غیرضروری قرار میگیرد. این فقدان انعطافپذیری،‬ ‫عامل اصلی خستگی لولهها است. افزون بر این، کنترل مبتنی بر قواعد تجربی دیگر برای شبکههای پیچیده مدرن‬\r\n‫که مانند سامانههای تصادفی یکپارچه رفتار میکنند، کارآمد نیست.‬\r\n‫در حال حاضر، شکاف قابلتوجهی میان چارچوبهای پیشرفته هوش مصنوعی و شبیهسازهای استاندارد‬ ‫هیدرولیکی وجود دارد. بهطور خاص، چارچوب منسجمی که الگوریتم بهینهسازی سیاست مجاورتی یا ‪ PPO‬را با‬ ‫محیطهای مبتنی بر ‪ EPANET‬ادغام کند، وجود ندارد. در حالیکه ‪ PPO‬برای «فضای عمل پیوسته» موردنیاز‬ ‫جهت تنظیمات دقیق و تدریجی شیرها بسیار مناسب است، کاربرد آن در مدیریت بلادرنگ شرکتهای آب و‬ ‫فاضلاب هنوز بهخوبی بررسی نشده است. بدون یک چارچوب کنترلی تطبیقی و بلادرنگ مبتنی بر یادگیری‬\r\n‫تقویتی عمیق‪ ، (DRL)‬شرکتهای آب همچنان در چرخه عملکرد واکنشی و ناکارآمد باقی خواهند ماند.‬\r\n‫ضرورت این پژوهش، ایجاد گذار از تنظیم فشار ایستا و واکنشی به یک الگوی کنترلی خودمختار و هوشمند مبتنی‬ ‫بر نظریه پیشرفته سیستمها است.‬\r\n‫مدیریت معاصر آب شهری فاقد یک چارچوب کنترلی پویا و هوشمند برای تنظیم بلادرنگ شیرهای فشارشکن‬ ‫‪(PRVs)‬است. این ضعف موجب تنش هیدرولیکی بیشازحد در دورههای کممصرف، افزایش آب بدون درآمد،‬\r\n‫شکستهای مکرر و فاجعهبار لولهها و اتلاف ناپایدار منابع آب آشامیدنی میشود.‬\r\n‫این پژوهش توسعه یک چارچوب یادگیری تقویتی عمیق ‪ (DRL)‬مبتنی بر الگوریتم ‪ PPO‬را پیشنهاد میکند که‬ ‫مستقیماً با موتور هیدرولیکی ‪ EPANET‬یکپارچه میشود. هدف، تبدیل شیرهای فشارشکن از اجزای مکانیکی‬ ‫ایستا به «عاملهای هوشمند» است. با آموزش این عاملها برای تعامل با محیط پیچیده و غیرخطی شبکه توزیع‬\r\n\r\n\f‫آب، سامانه خواهد آموخت که اقدامات بلادرنگی انجام دهد که تابع پاداش را بهینه کند؛ این تابع بهطور مشخص‬\r\n\r\n‫دانشکدهمهندسیصنایع‬\r\n\r\n‫شامل کمینهسازی نشتی همراه با حفظ فشار استاندارد خدمات است.‬\r\n\r\n‫اهداف اصلی این پژوهش عبارت هستند از:‬\r\n\r\n‫• برتری در کنترل تطبیقی :توسعه چارچوبی برای تنظیم خودکار و بلادرنگ‪ PRV‬ها بر اساس تغییرات‬ ‫چرخههای شبانهروزی تقاضا.‬\r\n\r\n‫• کاهش آب بدون درآمد :کاهش قابلتوجه تلفات واقعی از طریق حذف دورههای فشار بالای غیرضروری‬ ‫به کمک مدولاسیون هوشمند.‬\r\n\r\n‫• افزایش طول عمر زیرساخت :بهبود عمر سازهای شبکه با هموارسازی نوسانات فشار و کاهش خستگی‬ ‫چرخهای، بهگونهای که عامل ‪ DRL‬بیشترین پاداش را در زمینه «حفظ زیرساخت» دریافت کند.‬\r\n\r\n‫حل مسئله مدیریت فشار صرفاً یک موفقیت فنی نیست، بلکه پیششرطی برای تابآوری شهری محسوب میشود.‬ ‫اهمیت زیستمحیطی این پژوهش با «قاعده ‪ »1٪‬قابلبیان است: شواهد تجربی نشان میدهد که هر ‪ 1٪‬کاهش‬ ‫در هدررفت آب، منجر به ‪ 1٪‬کاهش در هزینه کل تولید و حفظ ‪ 1٪‬از منابع آب آشامیدنی موجود میشود. در‬ ‫سامانههای بزرگ شهری، این بهبودها معادل حفظ میلیونها مترمکعب آب و کاهش چشمگیر انرژی موردنیاز برای‬\r\n‫استخراج و تصفیه آب است.‬\r\n\r\n‫اهمیت اقتصادی برای شرکتهای آب و فاضلاب عبارت است از:‬\r\n\r\n‫‪ .1‬بهینهسازی مصرف انرژی :کاهش فشار غیرضروری باعث کاهش مصرف انرژی ایستگاههای پمپاژ و‬ ‫کاهش ردپای کربنی شرکت میشود.‬\r\n\r\n‫‪ .2‬حفظ زیرساخت :با کاهش تنشهای هیدرولیکی، تعداد تعمیرات اضطراری و هزینههای سرمایهای ناشی‬ ‫از تعویض زودهنگام لولهها بهشدت کاهش مییابد.‬\r\n\r\n‫‪ .3‬تثبیت درآمد :تبدیل آب بدون درآمد به مصرف قابلصورتحساب، وضعیت مالی شرکتهای آب و‬ ‫فاضلاب را تقویت کرده و امکان سرمایهگذاری بیشتر در فناوری را فراهم میکند.‬\r\n\r\n‫این پژوهش با استانداردهای انجمن بینالمللی آب ‪ (IWA)‬همسو است و مستقیماً از هدف ششم توسعه پایدار‬ ‫سازمان ملل متحد ‪ (SDG 6)‬در زمینه آب پاک و بهداشت حمایت میکند. در سطح ملی، این مطالعه با اهداف‬ ‫راهبردی برنامه هفتم توسعه کشور که بر نوسازی زیرساختهای آب و امنیت تأمین تأکید دارد، همراستا است.‬\r\n\r\n\f‫با تلفیق اصول پیشرفته مهندسی صنایع و علوم هیدرولیک، این پژوهش مسیری تحولآفرین ارائه میدهد تا‬\r\n\r\n‫دانشکدهمهندسیصنایع‬\r\n\r\n‫سامانههای آب شهری از منبع اتلاف به الگویی از بهرهوری هوشمند تبدیل شوند.‬\r\n\r\n‫شکل ‪ .1‬ترسیم فرایند کلی تعریف مساله پژوهش‬\r\n‫در این پژوهش )شکل ‪ ،)1‬ما به دنبال توسعه یک چارچوب کنترل تطبیقی و هوشمند برای مدیریت فشار در‬ ‫شبکههای توزیع آب هستیم که بتواند با کنترل هماهنگ شیرهای فشارشکن )‪ )PRV‬و پمپهای دور متغیر‬ ‫)‪ ،)VSP‬فشار شبکه را در مواجهه با نوسانات لحظهای و غیرقطعی تقاضا بهگونهای تنظیم کند که همزمان‬ ‫نشت آب کاهش یابد، فشار در محدوده مجاز خدماترسانی حفظ شود، از نوسانات مخرب فشار جلوگیری‬ ‫گردد و در صورت نیاز، مصرف انرژی نیز بهینه شود. روش کار، مبتنی بر یادگیری تقویتی عمیق )‪ )DRL‬و‬ ‫الگوریتم بهینهسازی خطمشی پروگزیمال )‪ )PPO‬است که با شبیهساز هیدرولیکی ‪ EPANET‬یکپارچه شده‬\r\n‫و در قالب یک محیط تعاملی در ‪ Python‬پیادهسازی میشود.‬\r\n‫مفروضات اصلی پژوهش عبارتاند از:‬\r\n‫• در دسترس بودن مدل هیدرولیکی شبکه )شامل توپولوژی، مشخصات لولهها، گرهها و مخازن‪،)‬‬ ‫• امکان تعریف سناریوهای مصرف متغیر و غیرقطعی،‬\r\n‫• در نظر گرفتن فضای عمل پیوسته برای تنظیم تدریجی تجهیزات،‬\r\n\r\n\f‫• و وجود یک تابع پاداش چندهدفه که بتواند بهصورت همزمان اهداف کاهش نشت، حفظ فشار، کاهش‬\r\n\r\n‫دانشکدهمهندسیصنایع‬\r\n\r\n‫نوسانات و کاهش انرژی را در فرآیند یادگیری لحاظ کند.‬\r\n\r\n‫این چارچوب، بر اساس تعامل مکرر عامل با محیط شبیهسازی، سیاست کنترلی را بدون نیاز به مدل تحلیلی‬ ‫دقیق از شبکه فرا میگیرد و عملکرد خود را در سناریوهای مختلف بهرهبرداری )عادی، اوج، کممصرف و‬\r\n‫غیرقطعی( ارزیابی میکند.‬\r\n\r\n‫‪ -2‬سابقه شکاف تحقيقات موجود و ضرورت انجام تحقيق‬\r\n‫شبکههای توزیع آب از مهمترین زیرساختهای شهری محسوب میشوند که وظیفه انتقال و تأمین پایدار آب‬ ‫شرب مورد نیاز مصرفکنندگان را بر عهده دارند. رشد جمعیت، توسعه شهرنشینی، محدودیت منابع آب شیرین‬ ‫و فرسودگی تدریجی زیرساختها موجب شده است که بهرهبرداری بهینه از این شبکهها به یکی از چالشهای‬ ‫اساسی صنعت آب تبدیل شود. در این میان، نشت آب و تلفات واقعی شبکه از مهمترین عوامل کاهش بهرهوری‬ ‫سامانههای توزیع آب به شمار میروند و سالانه موجب هدررفت حجم قابل توجهی از منابع آبی، افزایش هزینههای‬ ‫بهرهبرداری و کاهش قابلیت اطمینان شبکه میشوند. مطالعات مختلف نشان دادهاند که فشار هیدرولیکی یکی از‬ ‫مهمترین عوامل مؤثر بر میزان نشت، نرخ شکستگی لولهها و خرابی تجهیزات شبکه است؛ ازاینرو، مدیریت فشار‬ ‫بهعنوان یکی از مؤثرترین راهکارهای کاهش تلفات واقعی آب و افزایش پایداری بهرهبرداری از شبکههای توزیع‬\r\n‫آب شناخته میشود )لامبرت و تورنتون، ‪۲00۵‬؛ نجم و همکاران، ‪.)۲0۲4‬‬ ‫در دهههای گذشته، مدیریت فشار عمدتاً از طریق استفاده از شیرهای فشارشکن با تنظیمات ثابت انجام میشد.‬ ‫در این رویکرد، فشار خروجی تجهیزات کنترلی بر اساس شرایط اوج مصرف تنظیم میشود تا حداقل فشار مورد‬ ‫نیاز در تمام ساعات شبانهروز تأمین گردد. اگرچه این روش از نظر اجرایی ساده و کمهزینه است، اما به دلیل‬ ‫ماهیت ایستا و عدم توانایی در انطباق با تغییرات زمانی تقاضا، در بسیاری از ساعات شبانهروز فشار بیش از مقدار‬ ‫مورد نیاز را به شبکه اعمال میکند. این موضوع علاوه بر افزایش میزان نشت، موجب تشدید تنشهای هیدرولیکی،‬ ‫افزایش احتمال شکستگی لولهها و کاهش عمر مفید تجهیزات میشود. به همین دلیل، در پژوهشهای مرتبط با‬ ‫مدیریت فشار، بر نقش مستقیم فشار مازاد در افزایش تلفات و خرابی شبکه تأکید شده است )جوستولیسی و‬\r\n‫همکاران، ‪۲008‬؛ براردی و همکاران، ‪۲01۹‬؛ استاتسکو و همکاران، ‪.)۲0۲4‬‬ ‫به منظور رفع محدودیتهای روشهای سنتی، طی دو دهه اخیر رویکردهای مختلف بهینهسازی برای مدیریت‬ ‫فشار توسعه یافتهاند. در ابتدا، روشهای مبتنی بر برنامهریزی ریاضی و مدلهای تحلیلی برای تعیین تنظیمات‬ ‫بهینه تجهیزات کنترلی مورد استفاده قرار گرفتند. هرچند این روشها در شبکههای کوچک و شرایط نسبتاً پایدار‬","is_error":false}]},"uuid":"7569309f-0497-408a-8480-df72424a0871","timestamp":"2026-08-24T21:59:11.639Z","toolUseResult":{"stdout":"‫‪ -1‬تعریف مسأله و بيان موضوع اصلی تحقيق‬\r\n‫شبکههای توزیع آب ‪ (WDNs)‬بنیادیترین زیرساخت برای پایداری تمدنها محسوب میشوند و بهعنوان دانشکسدهیمهندسسیتصنایعم‬ ‫گردش حیاتی محیطهای شهری عمل میکنند. با افزایش همزمان تقاضای صنعتی و رشد نمایی جمعیت، مدیریت‬ ‫راهبردی منابع آب دیگر صرفاً یک فعالیت عملیاتی روزمره نیست، بلکه به مسئلهای مرتبط با امنیت ملی و جهانی‬ ‫تبدیل شده است. در این چارچوب، بحران جهانی کمبود آب بهدلیل ناکارآمدیهای ساختاری تشدید میشود؛‬ ‫برآوردها نشان میدهد سالانه حدود ‪ ۳۲‬میلیارد مترمکعب آب تصفیهشده در سامانههای توزیع جهانی هدر میرود‬\r\n‫.‪(Guo et al., 2013)‬کاهش این تلفات برای تضمین پایداری و تابآوری شهری ضروری است.‬\r\n\r\n‫در ادبیات مهندسی هیدرولیک، تمایز میان «تلفات واقعی» یعنی خروج فیزیکی آب از سیستم از طریق ترکیدگی‬ ‫لولهها، نشتی اتصالات و سرریز مخازن و مفهوم گستردهتر «آب بدون درآمد» ضروری است.‬\r\n\r\n‫علاوه بر تلفات واقعی، شامل مصرف مجاز بدون صورتحساب و تلفات تجاری نیز میشود. کاهش آب بدون درآمد‬ ‫صرفاً یک هدف مالی نیست، بلکه ضرورتی برای حفظ منابع آب بهشمار میرود. آمار مربوط به آب بدون درآمد‬\r\n‫نشاندهنده تفاوت شدید در بهرهوری زیرساختها میان کشورهای مختلف است:‬\r\n\r\n‫نرخ تقریبی آب بدون درآمد / نشتی‬\r\n\r\n‫منطقه / شرایط‬\r\n\r\n‫استاندارد کشورهای توسعهیافته حدود ‪1۵٪‬‬\r\n\r\n‫‪ 1۵٪‬تا ‪( ۳0٪‬طبش و واسطی، ‪)1۳8۵‬‬\r\n\r\n‫ایران )میانگین ملی(‬\r\n\r\n‫حدود ‪( ۳۲٪‬مرکز پژوهشهای مجلس، ‪)1۳۹۷‬‬\r\n\r\n‫ایران )بخش روستایی(‬\r\n\r\n‫میانگین کشورهای درحالتوسعه ‪ ۲0٪‬تا ‪۷0٪‬‬\r\n\r\n‫موارد بحرانی جهانی )مانند کامرون( ‪(Lemberger & Wyatt, 2018)۵0٫8٪‬‬\r\n\r\n‫از دیدگاه مهندسی سیستمها، فشار هیدرولیکی مهمترین عامل تخریب زیرساخت است. پژوهشهای دقیق سلطانی‬ ‫و مغربی )‪ )1۳88‬تأیید میکند که فشار بیشازحد مستقیماً با خستگی سریعتر لولهها، افزایش دفعات شکست و‬ ‫تشدید نرخ نشتی ارتباط دارد. اگرچه فشار بالا برای حفظ کیفیت خدمترسانی در ساعات اوج مصرف ضروری‬ ‫است، اما در ساعات کممصرف شبانه به یک تهدید ساختاری تبدیل میشود. راهبردهای فعلی مدیریت فشار بهدلیل‬\r\n‫ناتوانی تجهیزات کنترلی سنتی در تطبیق با این نوسانات، موجب فرسودگی زودهنگام زیرساخت میشوند.‬\r\n\r\n\f‫در تحقیقات هیدرولیک مدرن فاصله عمیقی میان مدیریت ایستا و ماهیت پویا و تصادفی مصرف آب شهری است.‬ ‫شبکههای مدرن توزیع آب دارای ابعاد بالا و تعاملات غیرخطی میان پمپها، مخازن و لولههایی با سنهای دانمشکدهمخهندتسلیصنایعف‬ ‫هستند که همگی تحت قوانین بقای جرم و انرژی )معادلات افت هد( عمل میکنند. مدلسازی ریاضی سنتی‬ ‫تلاش کرده این سامانهها را تحلیل کند، اما پیچیدگی محاسباتی حاصل، مانع بهینهسازی بلادرنگ میشود.‬ ‫اپراتورهای انسانی توانایی پردازش همزمان دادههای چندمتغیره — مانند نوسانات شبانهروزی دبی و شرایط خاک‬\r\n‫— را با سرعت لازم برای تنظیمات پیشگیرانه ندارند.‬\r\n‫مدیریت سنتی شیرهای فشارشکن‪ ، (PRVs)‬همانطور که توسط ‪ Vicente et al. (2016)‬بررسی شده، عمدتاً‬ ‫مبتنی بر «فشار خروجی ثابت» است. این روش عملاً منسوخ شده است؛ زیرا برای تضمین حداقل فشار خدماتی‬ ‫در گرههای بحرانی طی ساعات اوج مصرف، ‪PRV‬ها روی مقادیر بالای ثابت تنظیم میشوند. در نتیجه، در ساعات‬ ‫کممصرف شبانه، شبکه در معرض «موج» تنش هیدرولیکی غیرضروری قرار میگیرد. این فقدان انعطافپذیری،‬ ‫عامل اصلی خستگی لولهها است. افزون بر این، کنترل مبتنی بر قواعد تجربی دیگر برای شبکههای پیچیده مدرن‬\r\n‫که مانند سامانههای تصادفی یکپارچه رفتار میکنند، کارآمد نیست.‬\r\n‫در حال حاضر، شکاف قابلتوجهی میان چارچوبهای پیشرفته هوش مصنوعی و شبیهسازهای استاندارد‬ ‫هیدرولیکی وجود دارد. بهطور خاص، چارچوب منسجمی که الگوریتم بهینهسازی سیاست مجاورتی یا ‪ PPO‬را با‬ ‫محیطهای مبتنی بر ‪ EPANET‬ادغام کند، وجود ندارد. در حالیکه ‪ PPO‬برای «فضای عمل پیوسته» موردنیاز‬ ‫جهت تنظیمات دقیق و تدریجی شیرها بسیار مناسب است، کاربرد آن در مدیریت بلادرنگ شرکتهای آب و‬ ‫فاضلاب هنوز بهخوبی بررسی نشده است. بدون یک چارچوب کنترلی تطبیقی و بلادرنگ مبتنی بر یادگیری‬\r\n‫تقویتی عمیق‪ ، (DRL)‬شرکتهای آب همچنان در چرخه عملکرد واکنشی و ناکارآمد باقی خواهند ماند.‬\r\n‫ضرورت این پژوهش، ایجاد گذار از تنظیم فشار ایستا و واکنشی به یک الگوی کنترلی خودمختار و هوشمند مبتنی‬ ‫بر نظریه پیشرفته سیستمها است.‬\r\n‫مدیریت معاصر آب شهری فاقد یک چارچوب کنترلی پویا و هوشمند برای تنظیم بلادرنگ شیرهای فشارشکن‬ ‫‪(PRVs)‬است. این ضعف موجب تنش هیدرولیکی بیشازحد در دورههای کممصرف، افزایش آب بدون درآمد،‬\r\n‫شکستهای مکرر و فاجعهبار لولهها و اتلاف ناپایدار منابع آب آشامیدنی میشود.‬\r\n‫این پژوهش توسعه یک چارچوب یادگیری تقویتی عمیق ‪ (DRL)‬مبتنی بر الگوریتم ‪ PPO‬را پیشنهاد میکند که‬ ‫مستقیماً با موتور هیدرولیکی ‪ EPANET‬یکپارچه میشود. هدف، تبدیل شیرهای فشارشکن از اجزای مکانیکی‬ ‫ایستا به «عاملهای هوشمند» است. با آموزش این عاملها برای تعامل با محیط پیچیده و غیرخطی شبکه توزیع‬\r\n\r\n\f‫آب، سامانه خواهد آموخت که اقدامات بلادرنگی انجام دهد که تابع پاداش را بهینه کند؛ این تابع بهطور مشخص‬\r\n\r\n‫دانشکدهمهندسیصنایع‬\r\n\r\n‫شامل کمینهسازی نشتی همراه با حفظ فشار استاندارد خدمات است.‬\r\n\r\n‫اهداف اصلی این پژوهش عبارت هستند از:‬\r\n\r\n‫• برتری در کنترل تطبیقی :توسعه چارچوبی برای تنظیم خودکار و بلادرنگ‪ PRV‬ها بر اساس تغییرات‬ ‫چرخههای شبانهروزی تقاضا.‬\r\n\r\n‫• کاهش آب بدون درآمد :کاهش قابلتوجه تلفات واقعی از طریق حذف دورههای فشار بالای غیرضروری‬ ‫به کمک مدولاسیون هوشمند.‬\r\n\r\n‫• افزایش طول عمر زیرساخت :بهبود عمر سازهای شبکه با هموارسازی نوسانات فشار و کاهش خستگی‬ ‫چرخهای، بهگونهای که عامل ‪ DRL‬بیشترین پاداش را در زمینه «حفظ زیرساخت» دریافت کند.‬\r\n\r\n‫حل مسئله مدیریت فشار صرفاً یک موفقیت فنی نیست، بلکه پیششرطی برای تابآوری شهری محسوب میشود.‬ ‫اهمیت زیستمحیطی این پژوهش با «قاعده ‪ »1٪‬قابلبیان است: شواهد تجربی نشان میدهد که هر ‪ 1٪‬کاهش‬ ‫در هدررفت آب، منجر به ‪ 1٪‬کاهش در هزینه کل تولید و حفظ ‪ 1٪‬از منابع آب آشامیدنی موجود میشود. در‬ ‫سامانههای بزرگ شهری، این بهبودها معادل حفظ میلیونها مترمکعب آب و کاهش چشمگیر انرژی موردنیاز برای‬\r\n‫استخراج و تصفیه آب است.‬\r\n\r\n‫اهمیت اقتصادی برای شرکتهای آب و فاضلاب عبارت است از:‬\r\n\r\n‫‪ .1‬بهینهسازی مصرف انرژی :کاهش فشار غیرضروری باعث کاهش مصرف انرژی ایستگاههای پمپاژ و‬ ‫کاهش ردپای کربنی شرکت میشود.‬\r\n\r\n‫‪ .2‬حفظ زیرساخت :با کاهش تنشهای هیدرولیکی، تعداد تعمیرات اضطراری و هزینههای سرمایهای ناشی‬ ‫از تعویض زودهنگام لولهها بهشدت کاهش مییابد.‬\r\n\r\n‫‪ .3‬تثبیت درآمد :تبدیل آب بدون درآمد به مصرف قابلصورتحساب، وضعیت مالی شرکتهای آب و‬ ‫فاضلاب را تقویت کرده و امکان سرمایهگذاری بیشتر در فناوری را فراهم میکند.‬\r\n\r\n‫این پژوهش با استانداردهای انجمن بینالمللی آب ‪ (IWA)‬همسو است و مستقیماً از هدف ششم توسعه پایدار‬ ‫سازمان ملل متحد ‪ (SDG 6)‬در زمینه آب پاک و بهداشت حمایت میکند. در سطح ملی، این مطالعه با اهداف‬ ‫راهبردی برنامه هفتم توسعه کشور که بر نوسازی زیرساختهای آب و امنیت تأمین تأکید دارد، همراستا است.‬\r\n\r\n\f‫با تلفیق اصول پیشرفته مهندسی صنایع و علوم هیدرولیک، این پژوهش مسیری تحولآفرین ارائه میدهد تا‬\r\n\r\n‫دانشکدهمهندسیصنایع‬\r\n\r\n‫سامانههای آب شهری از منبع اتلاف به الگویی از بهرهوری هوشمند تبدیل شوند.‬\r\n\r\n‫شکل ‪ .1‬ترسیم فرایند کلی تعریف مساله پژوهش‬\r\n‫در این پژوهش )شکل ‪ ،)1‬ما به دنبال توسعه یک چارچوب کنترل تطبیقی و هوشمند برای مدیریت فشار در‬ ‫شبکههای توزیع آب هستیم که بتواند با کنترل هماهنگ شیرهای فشارشکن )‪ )PRV‬و پمپهای دور متغیر‬ ‫)‪ ،)VSP‬فشار شبکه را در مواجهه با نوسانات لحظهای و غیرقطعی تقاضا بهگونهای تنظیم کند که همزمان‬ ‫نشت آب کاهش یابد، فشار در محدوده مجاز خدماترسانی حفظ شود، از نوسانات مخرب فشار جلوگیری‬ ‫گردد و در صورت نیاز، مصرف انرژی نیز بهینه شود. روش کار، مبتنی بر یادگیری تقویتی عمیق )‪ )DRL‬و‬ ‫الگوریتم بهینهسازی خطمشی پروگزیمال )‪ )PPO‬است که با شبیهساز هیدرولیکی ‪ EPANET‬یکپارچه شده‬\r\n‫و در قالب یک محیط تعاملی در ‪ Python‬پیادهسازی میشود.‬\r\n‫مفروضات اصلی پژوهش عبارتاند از:‬\r\n‫• در دسترس بودن مدل هیدرولیکی شبکه )شامل توپولوژی، مشخصات لولهها، گرهها و مخازن‪،)‬‬ ‫• امکان تعریف سناریوهای مصرف متغیر و غیرقطعی،‬\r\n‫• در نظر گرفتن فضای عمل پیوسته برای تنظیم تدریجی تجهیزات،‬\r\n\r\n\f‫• و وجود یک تابع پاداش چندهدفه که بتواند بهصورت همزمان اهداف کاهش نشت، حفظ فشار، کاهش‬\r\n\r\n‫دانشکدهمهندسیصنایع‬\r\n\r\n‫نوسانات و کاهش انرژی را در فرآیند یادگیری لحاظ کند.‬\r\n\r\n‫این چارچوب، بر اساس تعامل مکرر عامل با محیط شبیهسازی، سیاست کنترلی را بدون نیاز به مدل تحلیلی‬ ‫دقیق از شبکه فرا میگیرد و عملکرد خود را در سناریوهای مختلف بهرهبرداری )عادی، اوج، کممصرف و‬\r\n‫غیرقطعی( ارزیابی میکند.‬\r\n\r\n‫‪ -2‬سابقه شکاف تحقيقات موجود و ضرورت انجام تحقيق‬\r\n‫شبکههای توزیع آب از مهمترین زیرساختهای شهری محسوب میشوند که وظیفه انتقال و تأمین پایدار آب‬ ‫شرب مورد نیاز مصرفکنندگان را بر عهده دارند. رشد جمعیت، توسعه شهرنشینی، محدودیت منابع آب شیرین‬ ‫و فرسودگی تدریجی زیرساختها موجب شده است که بهرهبرداری بهینه از این شبکهها به یکی از چالشهای‬ ‫اساسی صنعت آب تبدیل شود. در این میان، نشت آب و تلفات واقعی شبکه از مهمترین عوامل کاهش بهرهوری‬ ‫سامانههای توزیع آب به شمار میروند و سالانه موجب هدررفت حجم قابل توجهی از منابع آبی، افزایش هزینههای‬ ‫بهرهبرداری و کاهش قابلیت اطمینان شبکه میشوند. مطالعات مختلف نشان دادهاند که فشار هیدرولیکی یکی از‬ ‫مهمترین عوامل مؤثر بر میزان نشت، نرخ شکستگی لولهها و خرابی تجهیزات شبکه است؛ ازاینرو، مدیریت فشار‬ ‫بهعنوان یکی از مؤثرترین راهکارهای کاهش تلفات واقعی آب و افزایش پایداری بهرهبرداری از شبکههای توزیع‬\r\n‫آب شناخته میشود )لامبرت و تورنتون، ‪۲00۵‬؛ نجم و همکاران، ‪.)۲0۲4‬‬ ‫در دهههای گذشته، مدیریت فشار عمدتاً از طریق استفاده از شیرهای فشارشکن با تنظیمات ثابت انجام میشد.‬ ‫در این رویکرد، فشار خروجی تجهیزات کنترلی بر اساس شرایط اوج مصرف تنظیم میشود تا حداقل فشار مورد‬ ‫نیاز در تمام ساعات شبانهروز تأمین گردد. اگرچه این روش از نظر اجرایی ساده و کمهزینه است، اما به دلیل‬ ‫ماهیت ایستا و عدم توانایی در انطباق با تغییرات زمانی تقاضا، در بسیاری از ساعات شبانهروز فشار بیش از مقدار‬ ‫مورد نیاز را به شبکه اعمال میکند. این موضوع علاوه بر افزایش میزان نشت، موجب تشدید تنشهای هیدرولیکی،‬ ‫افزایش احتمال شکستگی لولهها و کاهش عمر مفید تجهیزات میشود. به همین دلیل، در پژوهشهای مرتبط با‬ ‫مدیریت فشار، بر نقش مستقیم فشار مازاد در افزایش تلفات و خرابی شبکه تأکید شده است )جوستولیسی و‬\r\n‫همکاران، ‪۲008‬؛ براردی و همکاران، ‪۲01۹‬؛ استاتسکو و همکاران، ‪.)۲0۲4‬‬ ‫به منظور رفع محدودیتهای روشهای سنتی، طی دو دهه اخیر رویکردهای مختلف بهینهسازی برای مدیریت‬ ‫فشار توسعه یافتهاند. در ابتدا، روشهای مبتنی بر برنامهریزی ریاضی و مدلهای تحلیلی برای تعیین تنظیمات‬ ‫بهینه تجهیزات کنترلی مورد استفاده قرار گرفتند